{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trovul",
  "version": "0.7.10",
  "identifier": "com.trovul.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trovul",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Trovul",
    "copyright": "Copyright © 2026 Trovul",
    "category": "Utility",
    "shortDescription": "Hear two PCs in one headset",
    "longDescription": "Trovul streams audio between two Windows PCs on the same network, so one headset hears both machines. One-click audio direction, automatic reconnect, low latency and per-app volume for both PCs.",
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/firewall.wxs"],
        "componentRefs": ["FirewallRules", "InputService"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
